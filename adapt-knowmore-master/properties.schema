{
    "type": "object",
	"$schema": "http://json-schema.org/draft-04/schema",
	"id": "http://jsonschema.net",
	"$ref": "http://localhost/plugins/content/component/model.schema",
	"globals": {
		"ariaRegion": {
			"type": "string",
			"required": true,
			"default": "Link items",
			"inputType": "Text",
			"validators": [],
			"translatable": true
		}
	},
	"properties": {
		"_supportedLayout": {
			"type": "string",
			"required": true,
			"enum": [
				"full-width",
				"half-width",
				"both"
			],
			"default": "half-width",
			"editorOnly": true
		},
		"instruction": {
			"type": "string",
			"required": false,
			"default": "",
			"inputType": "Text",
			"validators": [],
			"help": "This is the instruction text",
			"translatable": true
		},
		"_setCompletionOn": {
			"type": "string",
			"required": false,
			"default": "allItems",
			"title": "Set completion on:",
			"enum": [
				"inview",
				"allItems"
			],
			"inputType": {
				"type": "Select",
				"options": [
					"inview",
					"allItems"
				]
			},
			"validators": [],
			"help": "Whether completion is based on the learner having viewed all the items - or just having viewed the component"
		},
		"headerTitle": {
				"type": "string",
				"required": true,
				"inputType": "Text",
				"title": "Header title",
				"default": "Saiba mais",
				"validators": [],
				"help": "This is the header title",
				"translatable": true
		},
		"headerGraphic": {
			"type": "object",
			"required": true,
			"title": "Header graphic",
			"properties": {
				"src": {
					"type": "string",
					"required": true,
					"default": "",
					"inputType": "Asset:image",
					"validators": [],
					"help": "Image which will be rendered in the header"
				},
				"alt": {
					"type": "string",
					"required": false,
					"default": "",
					"title": "Alternative text",
					"inputType": "Text",
					"validators": [],
					"help": "A description of the image",
					"translatable": true
				}
			}
		},
		"bodyText": {
				"type": "string",
				"required": false,
				"inputType": "TextArea",
				"title": "Text body",
				"default": "Para saber mais, clique nos links abaixo:",
				"validators": [],
				"help": "This is the text body",
				"translatable": true
		},
		"_items": {
			"type": "array",
			"required": true,
			"title": "Items",
			"items": {
				"type": "object",
				"required": true,
				"properties": {
					"body": {
						"type": "string",
						"required": false,
						"inputType": "TextArea",
						"title": "Item body",
						"default": "",
						"validators": [],
						"help": "This is the item body",
						"translatable": true
					},
					"_graphic": {
						"type": "object",
						"required": false,
						"title": "Graphic",
						"properties": {
							"src": {
								"type": "string",
								"required": false,
								"default": "",
								"inputType": "Asset:image",
								"validators": [],
								"help": "Image which will be rendered with the item"
							},
							"alt": {
								"type": "string",
								"required": false,
								"default": "",
								"title": "Alternative text",
								"inputType": "Text",
								"validators": [],
								"help": "A description of the image",
								"translatable": true
							}
						}
					},
					"_link": {
						"type": "string",
						"required": true,
						"title": "Link",
						"inputType": "Asset",
						"validators": ["required"]
					}
				}
			}
		}
    }
}